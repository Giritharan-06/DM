{
  "name": "zyroz-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "eslint .",
    "typecheck": "turbo typecheck && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @zyroz/database generate",
    "db:migrate": "pnpm --filter @zyroz/database migrate",
    "db:seed": "tsx scripts/seed-catalog.ts",
    "owner:create": "tsx scripts/create-owner.ts",
    "jobs": "tsx scripts/jobs.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "tsx": "4.23.15",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "@zyroz/database": "workspace:*",
    "@zyroz/auth": "workspace:*",
    "@zyroz/validation": "workspace:*",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1",
    "zod": "4.6.5",
    "resend": "6.32.1",
    "better-auth": "1.7.7",
    "next": "16.4.0",
    "prettier": "3.9.9"
  },
  "dependencies": {
    "dotenv": "18.0.6"
  }
}
